  frame @232 ()->unit =
    c = cells.console()
    if c.video
      config()
      sys.memory_fill(sys.addr(c.framebuffer),0,c.stride * c.height)
      border = cells.parent.display.color(65,92,110)
      color = cells.parent.display.color(101,203,214)
      if c.layout == 0
        for row in 32..c.editor_bottom * 16
          sys.store32(sys.offset(sys.addr(c.framebuffer),row * c.stride + c.nav_end * 32),border)
          sys.store32(sys.offset(sys.addr(c.framebuffer),row * c.stride + c.inspector_start * 32),border)
        label = cells.parent.display.text(Text("SPACE / CELLS"),1,2,color)
        label = cells.parent.display.text(Text("INSPECTOR"),c.inspector_start + 1,2,color)
      if c.layout != 1
        for pixel in 0..c.columns * 8
          sys.store32(sys.offset(sys.addr(c.framebuffer),c.editor_bottom * 16 * c.stride + pixel * 4),border)
        label = cells.parent.display.text(Text("CONSOLE | :h help | :l layout"),1,c.console_top,color)
        c.output_region = 0
        history = cells.transcript()
        for index in 0..c.log_count
          // Queue USB releases as well as presses while replaying console glyphs.
          if index % 32 == 0
            cells.parent.keyboard.collect()
          offset = (c.log_next - c.log_count + 4096 + index) % 4096
          byte = (history[offset / 8] >> ((offset % 8) * 8)) & 255
          cells.parent.display.put(byte)
      c.frame_dirty = false
      c.sidebars_dirty = true
      cells.parent.editor.document().redraw = true
      c.dirty = true

    config @220 ()->unit =
      c = cells.console()
      c.nav_end = c.columns / 6
      if c.nav_end > 32
        c.nav_end = 32
      width = c.columns / 4
      if width > 48
        width = 48
      c.inspector_start = c.columns - width
      c.source_left = c.nav_end + 1
      c.source_right = c.inspector_start - 1
      c.console_top = c.rows - 11
      c.editor_bottom = c.console_top - 1
      if c.layout == 1
        c.source_left = 0
        c.source_right = c.columns
        c.editor_bottom = c.rows - 1
        c.console_top = c.rows - 1
      else if c.layout == 2
        c.source_left = 0
        c.source_right = 0
        c.editor_bottom = 2
        c.console_top = 2
      c.x = 1
      c.y = c.console_top + 1

    // Commands are views over existing console actions, not a second executor.
    layout @231 ()->unit =
      c = cells.console()
      c.layout = (c.layout + 1) % 3
      if cells.parent.editor.document().editing and c.layout == 2
        c.layout = 0
      c.frame_dirty = true


// Native autonomous neural graph. One BSP; bounded steps; optional disk checkpoints.
// Numeric event prediction and associative recall, not language understanding.
type Text  @2 = [i64,96]

cognition @63 ()->unit =
  struct State @3 :
    attempts: i64
    steps: i64
    observations: i64
    external: i64
    updates: i64
    replays: i64
    recalls: i64
    inspections: i64
    inspect_cursor: i64
    memory_next: i64
    memory_count: i64
    current_row: i64
    last_error: f32
    failures: i64
    streak: i64
    pulse: i64
    paused: bool
    quarantined: bool
    fresh: bool
    action: i64
    event_head: i64
    event_tail: i64
    event_count: i64
    next_event: i64
    dropped: i64
    input_length: i64
    input_overflow: bool
    world_enabled: bool
    world_rule: i64
    world_steps: i64
    world_hidden: i64
    world_delay: i64
    world_action: i64
    world_prediction: f32
    world_actual: f32
    world_error: f32
    world_mean: f32
    world_first: f32
    world_recent: f32
    world_phase_steps: i64
  // Eight recurrent feature-vector nodes, sixteen typed directed connections.
  type Nodes  @4 = tensor[f32,8,4]
  type Context  @5 = tensor[f32,32]
  type Signal  @6 = tensor[f32,4]
  type EdgeWeights  @7 = tensor[f32,16]
  type EdgeIds  @8 = [i64,16]
  type Messages  @9 = tensor[f32,16,4]
  type Head  @10 = tensor[f32,4,32]
  struct Synapses @11 :
    sources: Nodes
    targets: Nodes
    source_indices: EdgeIds
    target_indices: EdgeIds
  // One episode: previous recurrent context (32), actual signal (4), error (1).
  type Memory  @12 = tensor[f32,32,37]
  // Origin (0 self-inspection, 1 UART input, 2 discovery experiment), subject ID, logical tick, byte length.
  type Provenance  @13 = [i64,128]
  type Payloads  @14 = [i64,2048]
  type EventBytes  @15 = [i64,1024]
  type EventMeta  @16 = [i64,32]
  type Input  @17 = [i64,64]
  state @33 ()->State = State.persist()
  activity @34 ()->Nodes = Nodes.persist()
  edges @35 ()->EdgeWeights = EdgeWeights.persist()
  sources @36 ()->EdgeIds = EdgeIds.persist()
  targets @37 ()->EdgeIds = EdgeIds.persist()
  head @38 ()->Head = Head.persist()
  memory @39 ()->Memory = Memory.persist()
  provenance @40 ()->Provenance = Provenance.persist()
  payloads @41 ()->Payloads = Payloads.persist()
  event_bytes @42 ()->EventBytes = EventBytes.persist()
  event_meta @43 ()->EventMeta = EventMeta.persist()
  input @44 ()->Input = Input.persist()
  rate_base @45 ()->f32 = 0.02
  half @46 (value:f32)->f32 = value * 0.5

  activate @53 (value:f32)->f32 = value / math.sqrt(1.0 + value * value)

  // Readout and message passing are ordinary programmable Mira cells.
  readout @54 (weights:Head,context:Context,output:Signal)->unit =
    for lane in 0..4
      potential = 0.0
      for index in 0..32
        potential += weights[lane * 32 + index] * context[index]
      output[lane] = activate(potential)

  propagate @55 (nodes:Nodes,weights:EdgeWeights,from:EdgeIds,to:EdgeIds,signal:Signal,rate:f32)->unit =
    links = Synapses(nodes,nodes,from,to)
    messages = Messages()
    relation.messages_into(messages,links)
    for edge in 0..16
      for lane in 0..4
        messages[edge * 4 + lane] *= weights[edge]
    incoming = Nodes()
    relation.aggregate_into(incoming,links,messages)
    for node in 0..8
      for lane in 0..4
        index = node * 4 + lane
        stimulus = signal[lane] * (node == lane ? 0.7 : 0.05)
        potential = nodes[index] * 0.6 + incoming[index] + stimulus
        nodes[index] = activate(potential)
    // Bounded local Hebbian learning, independent of readout SGD.
    for edge in 0..16
      correlation = 0.0
      for lane in 0..4
        correlation += nodes[from[edge] * 4 + lane] * nodes[to[edge] * 4 + lane]
      value = weights[edge] + rate * 0.1 * (correlation * 0.25 - weights[edge] * 0.2)
      value = value < -0.5 ? -0.5 : value
      weights[edge] = value > 0.5 ? 0.5 : value

  initialize @56 ()->unit =
    tensor.fill(cells.topology.head(),0.0)
    tensor.fill(cells.memory.memory(),0.0)
    for index in 0..32
      cells.dynamics.activity()[index] = math.to_f32(index % 7 - 3) / 32.0
    for node in 0..8
      cells.topology.sources()[node * 2] = node
      cells.topology.targets()[node * 2] = (node + 1) % 8
      cells.topology.edges()[node * 2] = 0.08
      cells.topology.sources()[node * 2 + 1] = node
      cells.topology.targets()[node * 2 + 1] = (node + 3) % 8
      cells.topology.edges()[node * 2 + 1] = -0.04
    for index in 0..128
      cells.memory.provenance()[index] = 0
    for index in 0..2048
      cells.memory.payloads()[index] = 0
    for index in 0..1024
      cells.events.event_bytes()[index] = 0
    for index in 0..32
      cells.events.event_meta()[index] = 0
    s = cells.dynamics.state()
    s.attempts = 0
    s.steps = 0
    s.observations = 0
    s.external = 0
    s.updates = 0
    s.replays = 0
    s.recalls = 0
    s.inspections = 0
    s.inspect_cursor = 0
    s.memory_next = 0
    s.memory_count = 0
    s.current_row = 0
    s.last_error = 0.0
    s.failures = 0
    s.streak = 0
    s.pulse = 0
    s.quarantined = false
    s.fresh = false
    s.action = 0
    s.event_head = 0
    s.event_tail = 0
    s.event_count = 0
    s.next_event = 0
    s.dropped = 0
    s.world_enabled = false
    s.world_rule = 0
    s.world_steps = 0
    s.world_hidden = 0
    s.world_delay = 0
    s.world_action = 0
    s.world_prediction = 0.0
    s.world_actual = 0.0
    s.world_error = 0.0
    s.world_mean = 0.0
    s.world_first = 0.0
    s.world_recent = 0.0
    s.world_phase_steps = 0

  // The deterministic adapter retains actual observations before invoking learning.
  // A failed neural transaction cannot erase an event or manufacture an observation.
  remember @57 (signal:Signal,origin:i64,subject:i64,length:i64,event_offset:i64)->unit =
    nearest @60 ()->i64 =
      s = cells.dynamics.state()
      memory = cells.memory.memory()
      selected = -1
      best = 1000000.0
      for row in 0..s.memory_count
        distance = 0.0
        for index in 0..32
          delta = cells.dynamics.activity()[index] - memory[row * 37 + index]
          distance += delta * delta
        if distance < best
          best = distance
          selected = row
      selected

    s = cells.dynamics.state()
    row = s.memory_next
    episodes = cells.memory.memory()
    for index in 0..32
      episodes[row * 37 + index] = cells.dynamics.activity()[index]
    for lane in 0..4
      episodes[row * 37 + 32 + lane] = signal[lane]
    episodes[row * 37 + 36] = -1.0
    meta = cells.memory.provenance()
    meta[row * 4] = origin
    meta[row * 4 + 1] = subject
    meta[row * 4 + 2] = s.attempts
    meta[row * 4 + 3] = length
    for index in 0..64
      cells.memory.payloads()[row * 64 + index] = index < length ? cells.events.event_bytes()[event_offset + index] : 0
    s.memory_next = (row + 1) % 32
    if s.memory_count < 32
      s.memory_count += 1
    s.current_row = row
    s.observations += 1
    s.fresh = true
    if origin == 1
      s.external += 1

  observe_self @58 ()->unit =
    s = cells.dynamics.state()
    inner = reflect.inner(reflect.self())
    count = reflect.cell_count(inner)
    if count > 0
      cell = reflect.cell_at(inner,s.inspect_cursor % count)
      signal = Signal(math.to_f32(reflect.name_byte(cell,0)) / 255.0,math.to_f32(reflect.input_count(cell)) / 16.0,math.to_f32(reflect.output_count(cell)) / 16.0,math.to_f32(reflect.link_count(inner)) / 16.0)
      remember(signal,0,cell,0,0)
      s.inspect_cursor = (s.inspect_cursor + 1) % count
      s.inspections += 1

  observe_input @59 ()->unit =
    s = cells.dynamics.state()
    slot = s.event_head
    length = cells.events.event_meta()[slot * 2]
    total = 0
    folded = 0
    for index in 0..length
      code = cells.events.event_bytes()[slot * 64 + index]
      total += code
      folded = (folded * 33 + code) % 65536
    signal = Signal(math.to_f32(total) / math.to_f32(length * 255),math.to_f32(cells.events.event_bytes()[slot * 64 + length - 1]) / 255.0,math.to_f32(length) / 64.0,math.to_f32(folded) / 65535.0)
    remember(signal,1,cells.events.event_meta()[slot * 2 + 1],length,slot * 64)
    s.event_head = (slot + 1) % 16
    s.event_count -= 1

  neural_step @62 ()->unit =
    train @61 (context:Context,target:Signal)->f32 =
      loss @52 (value:f32)->f32 = value * value
      prediction = Signal()
      cells.readout(cells.topology.head(),context,prediction)
      total_error = 0.0
      weights = cells.topology.head()
      for lane in 0..4
        potential = 0.0
        for index in 0..32
          potential += weights[lane * 32 + index] * context[index]
        error = prediction[lane] - target[lane]
        total_error += loss(error)
        gradient = diff.derivative(loss,error) * diff.derivative(activate,potential)
        for index in 0..32
          value = weights[lane * 32 + index] - graph.parent.rate() * gradient * context[index]
          value = value < -2.0 ? -2.0 : value
          weights[lane * 32 + index] = value > 2.0 ? 2.0 : value
      cells.dynamics.state().updates += 1
      total_error * 0.25

    s = cells.dynamics.state()
    row = s.fresh ? s.current_row : remember.nearest()
    if row >= 0 and row < 32
      memory = cells.memory.memory()
      context = Context()
      signal = Signal()
      for index in 0..32
        context[index] = memory[row * 37 + index]
      for lane in 0..4
        signal[lane] = memory[row * 37 + 32 + lane]
      if s.fresh
        error = train(context,signal)
        memory[row * 37 + 36] = error
        s.last_error = error
        s.action = 0
      else
        // Neural activity and surprise select replay versus associative recall.
        s.recalls += 1
        if cells.dynamics.activity()[0] + s.last_error > cells.dynamics.activity()[4]
          error = train(context,signal)
          s.last_error = error
          s.replays += 1
          s.action = 2
        else
          s.action = 1
      cells.messagepass(cells.dynamics.activity(),cells.topology.edges(),cells.topology.sources(),cells.topology.targets(),signal,graph.parent.rate())
      s.steps += 1

  // One environment, the same recurrent graph, readout, learning and episode ring.
  // Prediction is recorded BEFORE transition; neither rule nor hidden state is input.
  discover @398 ()->unit =
    s = cells.dynamics.state()
    action = (s.world_steps / 5) % 4
    context = Context()
    prediction = Signal()
    if s.world_steps % 5 != 0
      best = -2.0
      for candidate in 0..4
        features(context,candidate)
        cells.readout(cells.topology.head(),context,prediction)
        if prediction[0] > best
          best = prediction[0]
          action = candidate
    features(context,action)
    cells.readout(cells.topology.head(),context,prediction)
    s.world_action = action
    s.world_prediction = prediction[0]
    previous = s.world_actual
    // Deterministic environment. The learner only receives the resulting signal.
    actual = 0.1
    if action == 0
      s.world_hidden = 1 - s.world_hidden
      actual = 0.2
    else if action == 1
      high = s.world_hidden == s.world_rule
      actual = high ? 0.8 : 0.2
    else if action == 2
      s.world_delay = s.world_rule == 0 ? 2 : 3
    if s.world_delay > 0
      s.world_delay -= 1
      if s.world_delay == 0
        actual = 0.9
    s.world_actual = actual
    error = (prediction[0] - actual) * (prediction[0] - actual)
    s.world_error = error
    s.world_steps += 1
    s.world_phase_steps += 1
    s.world_mean += (error - s.world_mean) / math.to_f32(s.world_phase_steps)
    if s.world_phase_steps <= 16
      s.world_first += (error - s.world_first) / math.to_f32(s.world_phase_steps)
    s.world_recent = s.world_phase_steps == 1 ? error : s.world_recent + (error - s.world_recent) * 0.125
    signal = Signal(actual,math.to_f32(action) / 3.0,previous,1.0)
    remember(signal,2,s.world_rule * 4 + action,0,0)
    // remember retains the normal episode format, including the pre-result context.
    for index in 0..32
      cells.memory.memory()[s.current_row * 37 + index] = context[index]

    features @399 (context:Context,action:i64)->unit =
      for index in 0..32
        context[index] = cells.dynamics.activity()[index]
      context[0] = 1.0
      for candidate in 0..4
        context[candidate + 1] = candidate == action ? 1.0 : 0.0
      context[5] = cells.dynamics.state().world_actual
      context[6] = math.to_f32(cells.dynamics.state().world_steps % 16) / 15.0
      context[31] = 1.0

    control @400 (change:bool)->unit =
      s = cells.dynamics.state()
      if change
        s.world_rule = 1 - s.world_rule
        s.world_phase_steps = 0
        s.world_mean = 0.0
        s.world_first = 0.0
        s.world_recent = 0.0
        cells.parent.workspace.write(Text("world rules changed; weights and experience retained\n"))
      else
        s.world_enabled = not s.world_enabled
        cells.parent.workspace.write(Text("world experiment toggled; :D shows predictions and errors\n"))
      report()

    report @401 ()->unit =
      s = cells.dynamics.state()
      cells.parent.workspace.write(Text("world enabled/rule/steps/phase-steps/action: "))
      cells.parent.workspace.number(s.world_enabled ? 1 : 0)
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(s.world_rule)
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(s.world_steps)
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(s.world_phase_steps)
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(s.world_action)
      cells.parent.workspace.write(Text("\nprediction/observed/error: "))
      cells.parent.workspace.fixed(s.world_prediction)
      cells.parent.workspace.put(47)
      cells.parent.workspace.fixed(s.world_actual)
      cells.parent.workspace.put(47)
      cells.parent.workspace.fixed(s.world_error)
      cells.parent.workspace.write(Text("\nerror first16/recent-EWMA/phase-mean: "))
      cells.parent.workspace.fixed(s.world_first)
      cells.parent.workspace.put(47)
      cells.parent.workspace.fixed(s.world_recent)
      cells.parent.workspace.put(47)
      cells.parent.workspace.fixed(s.world_mean)
      cells.parent.workspace.write(Text("\nactions: 0 toggle, 1 read, 2 pulse, 3 wait; every fifth step explores\n"))
      cells.parent.workspace.write(Text("origin2 episodes share neural memory; phase change is not proof of transfer\n"))

  show_status @64 ()->unit =
    s = cells.dynamics.state()
    cells.parent.workspace.write(Text("attempts/steps/observations/external: "))
    cells.parent.workspace.number(s.attempts)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.steps)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.observations)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.external)
    cells.parent.workspace.write(Text("\nupdates/replays/recalls/memory: "))
    cells.parent.workspace.number(s.updates)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.replays)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.recalls)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.memory_count)
    cells.parent.workspace.write(Text("\npaused/quarantined/failures/pending/dropped: "))
    cells.parent.workspace.number(s.paused ? 1 : 0)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.quarantined ? 1 : 0)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.failures)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.event_count)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.dropped)
    cells.parent.workspace.write(Text("\nactivity/readout-sum/last-error/action: "))
    cells.parent.workspace.fixed(cells.dynamics.activity()[0])
    cells.parent.workspace.put(47)
    cells.parent.workspace.fixed(tensor.sum(cells.topology.head()))
    cells.parent.workspace.put(47)
    cells.parent.workspace.fixed(s.last_error)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(s.action)
    cells.parent.workspace.put(10)

  show_memory @65 ()->unit =
    s = cells.dynamics.state()
    cells.parent.workspace.write(Text("memory: origin/subject/tick/error/payload; 0=self, 1=input, 2=world (subject=rule*4+action)\n"))
    count = s.memory_count < 8 ? s.memory_count : 8
    for index in 0..count
      row = (s.memory_next + 32 - count + index) % 32
      meta = cells.memory.provenance()
      cells.parent.workspace.number(meta[row * 4])
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(meta[row * 4 + 1])
      cells.parent.workspace.put(47)
      cells.parent.workspace.number(meta[row * 4 + 2])
      cells.parent.workspace.put(47)
      cells.parent.workspace.fixed(cells.memory.memory()[row * 37 + 36])
      cells.parent.workspace.put(47)
      for byte in 0..meta[row * 4 + 3]
        code = cells.memory.payloads()[row * 64 + byte]
        cells.parent.workspace.put(code >= 32 and code <= 126 ? code : 46)
      cells.parent.workspace.put(10)

  reset @71 ()->unit =
    accepted = sys.neural_try(initialize,300000,4096)
    if accepted
      d = cells.parent.storage.state()
      d.foreign = false
      d.last_steps = 0
      d.last_external = 0
      d.requested = true
      d.reset_requested = true
      d.report = true
      cells.parent.workspace.write(Text("neural state and experience reset\n"))
    else
      cells.dynamics.state().failures += 1
      cells.parent.workspace.write(Text("reset failed; previous state retained\n"))

  s = cells.dynamics.state()
  if not s.paused and not s.quarantined
    s.pulse += 1
    // Cooperative pacing, not a hardware clock or a promised wall-time rate.
    if s.pulse >= 512
      s.pulse = 0
      s.attempts += 1
      s.fresh = false
      if s.event_count > 0
        observe_input()
      else if s.world_enabled
        predicted = sys.neural_try(discover,300000,8192)
        if not predicted
          s.quarantined = true
          cells.parent.workspace.write(Text("world prediction failed; neural component quarantined\n"))
      else if s.memory_count == 0 or s.attempts % 16 == 1
        observe_self()
      accepted = not s.quarantined and sys.neural_try(neural_step,300000,16384)
      if accepted
        s.streak = 0
        if s.steps % 128 == 0
          cells.parent.workspace.console().dirty = true
        d = cells.parent.storage.state()
        if d.bound and not d.foreign and (s.external > d.last_external or s.steps - d.last_steps >= 1024)
          d.requested = true
      else
        s.failures += 1
        s.streak += 1
        if s.streak >= 3
          s.quarantined = true
          cells.parent.workspace.write(Text("\nneural component quarantined; console remains available\nready> "))


storage @69 ()->unit =
  volume_sectors @386 ()->i64 = 4096

  type Snapshot  @21 = tensor[i64,8192]
  type Sector  @22 = [i64,64]
  struct Disk @23 :
    online: bool
    bound: bool
    failed: bool
    foreign: bool
    base: i64
    dma: i64
    snapshot: i64
    index: i64
    generation: i64
    bank: i64
    saves: i64
    restored: i64
    rejected: i64
    last_steps: i64
    last_external: i64
    requested: bool
    reset_requested: bool
    report: bool
    halt: bool
    success: bool
  notice @67 ()->unit =
    if cells.state().success
      cells.parent.workspace.write(Text("checkpoint saved\nready> "))
    else
      cells.parent.workspace.write(Text("checkpoint unavailable; previous disk record retained\nready> "))

  halt @68 ()->unit =
    cells.parent.workspace.write(Text("halted\n"))
    sys.halt()

  // Aggregate buffer addresses are obtained outside scratch/neural regions.
  // Only pinned boot buffers are used; notices get their own scratch scope.
  state @143 ()->Disk = Disk.persist()
  sector @144 ()->Sector = Sector.persist()

  snapshot_words @145 ()->i64 = (State.size_bytes() + Nodes.size_bytes() + EdgeWeights.size_bytes() + EdgeIds.size_bytes() + EdgeIds.size_bytes() + Head.size_bytes() + Memory.size_bytes() + Provenance.size_bytes() + Payloads.size_bytes() + EventBytes.size_bytes() + EventMeta.size_bytes()) / 8

  disk_start @148 (snapshot:Snapshot)->unit =
    disk_fail @146 ()->unit =
      d = cells.state()
      if d.base > 0
        sys.out8(d.base + 18,0)
      d.failed = true
      d.online = false
      d.bound = false

    // OASIS Virtio split queue, legacy PCI transport, queue-size 256.
    // https://docs.oasis-open.org/virtio/virtio/v1.2/virtio-v1.2.html
    // One synchronous request; pinned root buffers are never recycled on timeout.
    disk_request @147 (kind:i64,sector:i64)->bool =
      d = cells.state()
      ok = false
      if d.online and (kind == 0 or d.bound) and (kind == 0 or kind == 1 or kind == 4) and sector >= 0 and sector < volume_sectors()
        q = sys.addr(d.dma)
        header = sys.offset(q,12288)
        data = sys.offset(q,12304)
        status = sys.offset(q,12816)
        sys.store32(header,kind)
        sys.store32(sys.offset(header,4),0)
        sys.store64(sys.offset(header,8),kind == 4 ? 0 : sector)
        sys.store8(status,255)
        sys.store64(q,sys.address_value(header))
        sys.store32(sys.offset(q,8),16)
        sys.store16(sys.offset(q,12),1)
        sys.store16(sys.offset(q,14),kind == 4 ? 2 : 1)
        sys.store64(sys.offset(q,16),sys.address_value(data))
        sys.store32(sys.offset(q,24),512)
        sys.store16(sys.offset(q,28),kind == 0 ? 3 : 1)
        sys.store16(sys.offset(q,30),2)
        sys.store64(sys.offset(q,32),sys.address_value(status))
        sys.store32(sys.offset(q,40),1)
        sys.store16(sys.offset(q,44),2)
        sys.store16(sys.offset(q,46),0)
        sys.store16(sys.offset(q,4100 + (d.index % 256) * 2),0)
        d.index = (d.index + 1) & 65535
        sys.memory_fence()
        sys.store16(sys.offset(q,4098),d.index)
        sys.memory_fence()
        sys.out16(d.base + 16,0)
        spins = 0
        while spins < 1000000 and sys.load16(sys.offset(q,8194)) != d.index
          spins += 1
          sys.pause()
        sys.memory_fence()
        if sys.load16(sys.offset(q,8194)) == d.index
          used = sys.load32(sys.offset(q,8196 + ((d.index + 65535) % 256) * 8))
          ok = used == 0 and sys.load8(status) == 0
        if not ok
          disk_fail()
      ok

    d = cells.state()

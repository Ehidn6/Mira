  sidebars @235 ()->unit =
    c = cells.console()
    if c.video
      scope = browse.current()
      if c.graph_selected <= 0 or (c.graph_selected != scope and reflect.parent(c.graph_selected) != scope)
        c.graph_selected = scope
      // The path is generated from the same containment as navigation.
      sys.memory_fill(sys.addr(c.framebuffer),0,c.stride * 16)
      old_x = c.x
      old_y = c.y
      c.output_region = 3
      c.x = 1
      c.y = 0
      write(Text("MIRA | /"))
      browse.path(scope)
      if c.layout == 0
        for row in 48..c.editor_bottom * 16
          sys.memory_fill(sys.offset(sys.addr(c.framebuffer),row * c.stride),0,c.nav_end * 32)
          sys.memory_fill(sys.offset(sys.addr(c.framebuffer),row * c.stride + (c.inspector_start + 1) * 32),0,(c.columns - c.inspector_start - 1) * 32)
        c.output_region = 1
        c.x = 1
        c.y = 3
        nodes()
        c.output_region = 2
        c.x = c.inspector_start + 1
        c.y = 3
        browse(c.graph_selected)
      c.output_region = 0
      c.x = old_x
      c.y = old_y
    c.sidebars_dirty = false

  // These views query the compiled Program. Containment and graph links remain
  // distinct: following a wire never changes its endpoints or the source draft.
    name @233 (node:i64,limit:i64)->unit =
      for index in 0..limit
        byte = reflect.name_byte(node,index)
        if byte >= 0
          put(byte)

    nodes @234 ()->unit =
      c = cells.console()
      scope = browse.current()
      write(Text("SPACE: "))
      name(scope,c.nav_end - 9)
      put(10)
      write(Text("Cells: "))
      number(reflect.cell_count(scope))
      put(10)
      put(10)
      first = c.graph_page * 16
      for index in first..first + 16
        if index < reflect.cell_count(scope)
          node = reflect.cell_at(scope,index)
          put(node == c.graph_selected ? 62 : 32)
          number(node)
          put(32)
          room = c.nav_end - 1 - c.x
          if room > 0
            name(node,room)
          put(10)
      put(10)
      write(Text(":i ID select\n:z ID enter\n:o outer\n:n/:m page\n"))


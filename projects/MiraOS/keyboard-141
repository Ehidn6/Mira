keyboard @141 ()->unit =
  k = cells.state()
  u = cells.parent.usb.host()
  collect()
  for report in 0..16
    if k.ready and k.queued_count > 0
      current = k.report + 256 + k.queued_head * 8
      k.queued_head = (k.queued_head + 1) % 32
      k.queued_count -= 1
      k.reports += 1
      k.modifiers = sys.load8(sys.addr(current))
      rollover = false
      for index in 2..8
        usage = sys.load8(sys.addr(current + index))
        if usage > 0 and usage < 4
          rollover = true
      if not rollover
        for index in 2..8
          usage = sys.load8(sys.addr(current + index))
          seen = usage == 0
          for previous in 2..8
            seen = seen or sys.load8(sys.addr(k.report + 8 + previous)) == usage
          if not seen
            k.usage = usage
            k.key_modifiers = k.modifiers
            sys.scratch(press,32768)
            k.repeat_usage = 0
            if not cells.parent.editor.document().argument_active and not cells.parent.workspace.console().palette_open and press.repeat_allowed(usage,k.modifiers)
              k.repeat_usage = usage
              k.repeat_modifiers = k.modifiers
              k.repeat_tick = cells.parent.usb.ticks()
              k.repeat_wait = 4000
        sys.memory_copy(sys.addr(k.report + 8),sys.addr(current),8)
      else
        k.rejected += 1
  if k.ready
    k.checks += 1
    if k.checks % 512 == 0
      port = sys.load32(sys.addr(u.operational + 0x400 + (k.port - 1) * 16))
      if (port & 1) == 0
        k.ready = false
        k.error = 5
        released = cells.parent.usb.command(10,k.slot,0)
        u.transfer_pending = 0


  struct Keyboard @20 :
    attempted: bool
    ready: bool
    error: i64
    port: i64
    slot: i64
    speed: i64
    output: i64
    input: i64
    control_ring: i64
    control_index: i64
    control_cycle: i64
    data: i64
    interrupt_ring: i64
    interrupt_index: i64
    interrupt_cycle: i64
    report: i64
    endpoint: i64
    interface: i64
    configuration: i64
    packet: i64
    interval: i64
    vendor: i64
    product: i64
    modifiers: i64
    caps: bool
    usage: i64
    key_modifiers: i64
    reports: i64
    rejected: i64
    checks: i64
    queued_head: i64
    queued_tail: i64
    queued_count: i64
    repeat_usage: i64
    repeat_modifiers: i64
    repeat_tick: i64
    repeat_wait: i64
  state @127 ()->Keyboard = Keyboard.persist()

  attach @133 (port:i64)->bool =
    k = cells.state()
    u = cells.parent.usb.host()
    k.slot = 0
    k.port = port
    status = sys.load32(sys.addr(u.operational + 0x400 + (port - 1) * 16))
    ok = (status & 1) != 0
    if ok
      address = u.operational + 0x400 + (port - 1) * 16
      sys.store32(sys.addr(address),(status & 0x0e00c200) | 16)
      ok = cells.parent.usb.start.wait(address,16,0,1000000) and cells.parent.usb.start.wait(address,2,2,1000000)
      if ok
        // USB2 speed is valid only after port reset has completed.
        k.speed = (sys.load32(sys.addr(address)) >> 10) & 15
        ok = k.speed >= 1 and k.speed <= 3
      if ok
        ok = cells.parent.usb.delay(80)
    if ok
      ok = cells.parent.usb.command(9,0,0)
      k.slot = ok ? u.last_slot : 0
    if ok
      k.output = cells.parent.hardware.physical_allocate(1,4096)
      k.input = cells.parent.hardware.physical_allocate(1,4096)
      k.control_ring = cells.parent.hardware.physical_allocate(1,4096)
      k.data = cells.parent.hardware.physical_allocate(1,4096)
      k.interrupt_ring = cells.parent.hardware.physical_allocate(1,4096)
      k.report = cells.parent.hardware.physical_allocate(1,4096)
      ok = k.output > 0 and k.input > 0 and k.control_ring > 0 and k.data > 0 and k.interrupt_ring > 0 and k.report > 0
    if ok
      k.control_index = 0
      k.interrupt_index = 0
      k.control_cycle = 1
      k.interrupt_cycle = 1
      sys.store64(sys.addr(u.dcbaa + k.slot * 8),k.output)
      size = u.context_bytes
      sys.store32(sys.addr(k.input + 4),3)
      sys.store32(sys.addr(k.input + size),(k.speed << 20) | (1 << 27))
      sys.store32(sys.addr(k.input + size + 4),port << 16)
      packet = k.speed == 3 ? 64 : 8
      sys.store32(sys.addr(k.input + size * 2 + 4),6 | (4 << 3) | (packet << 16))
      sys.store64(sys.addr(k.input + size * 2 + 8),k.control_ring | 1)
      sys.store32(sys.addr(k.input + size * 2 + 16),8)
      sys.memory_fence()
      ok = cells.parent.usb.command(11,k.slot,k.input)
    if ok
      ok = control(128,6,256,0,8)
      if ok
        packet = press.byte(7)
        ok = packet == 8 or packet == 16 or packet == 32 or packet == 64
        if ok
          size = u.context_bytes
          sys.memory_fill(sys.addr(k.input),0,4096)
          sys.store32(sys.addr(k.input + 4),2)
          sys.memory_copy(sys.addr(k.input + size * 2),sys.addr(k.output + size),size)
          flags = sys.load32(sys.addr(k.input + size * 2 + 4)) & 65535
          sys.store32(sys.addr(k.input + size * 2 + 4),flags | (packet << 16))
          ok = cells.parent.usb.command(13,k.slot,k.input)
    if ok
      ok = control(128,6,256,0,18)
      if ok
        ok = press.byte(0) == 18 and press.byte(1) == 1 and press.byte(4) != 9
        k.vendor = press.byte(8) | (press.byte(9) << 8)
        k.product = press.byte(10) | (press.byte(11) << 8)
    if ok
      ok = control(128,6,512,0,9)
    total = 0
    if ok
      total = press.byte(2) | (press.byte(3) << 8)
      k.configuration = press.byte(5)
      ok = press.byte(1) == 2 and total >= 9 and total <= 4096 and k.configuration > 0
    if ok
      ok = control(128,6,512,0,total)
    if ok
      position = 0
      candidate = false
      found = false
      while position + 2 <= total and ok
        length = press.byte(position)
        kind = press.byte(position + 1)
        if length < 2 or length > total - position
          ok = false
        else
          if kind == 4 and length >= 9
            candidate = press.byte(position + 3) == 0 and press.byte(position + 5) == 3 and press.byte(position + 6) == 1 and press.byte(position + 7) == 1
            if candidate and not found
              k.interface = press.byte(position + 2)
          if kind == 5 and length >= 7 and candidate and not found
            endpoint = press.byte(position + 2)
            packet = press.byte(position + 4) | (press.byte(position + 5) << 8)
            interval = press.byte(position + 6)
            if (endpoint & 128) != 0 and (endpoint & 15) > 0 and (press.byte(position + 3) & 3) == 3 and packet >= 8 and packet <= 1024 and interval > 0
              k.endpoint = (endpoint & 15) * 2 + 1
              k.packet = packet
              k.interval = k.speed == 3 ? interval - 1 : 3
              if k.speed != 3
                while interval > 1
                  interval /= 2
                  k.interval += 1
              found = true
          position += length
      ok = ok and found and position == total and k.interval <= 15
    if ok
      size = u.context_bytes
      sys.memory_fill(sys.addr(k.input),0,4096)
      sys.store32(sys.addr(k.input + 4),1 | (1 << k.endpoint))
      sys.memory_copy(sys.addr(k.input + size),sys.addr(k.output),size)
      flags = sys.load32(sys.addr(k.input + size)) & 0x07ffffff
      sys.store32(sys.addr(k.input + size),flags | (k.endpoint << 27))
      ep = k.input + (k.endpoint + 1) * size
      sys.store32(sys.addr(ep),k.interval << 16)
      sys.store32(sys.addr(ep + 4),6 | (7 << 3) | (k.packet << 16))
      sys.store64(sys.addr(ep + 8),k.interrupt_ring | 1)
      sys.store32(sys.addr(ep + 16),8 | (k.packet << 16))
      sys.memory_fence()
      ok = cells.parent.usb.command(12,k.slot,k.input)
    if ok
      ok = control(0,9,k.configuration,0,0)
    if ok
      ok = control(33,11,0,k.interface,0)
    if not ok and k.slot > 0 and u.ready
      released = cells.parent.usb.command(10,k.slot,0)
      u.transfer_pending = 0
      k.slot = 0
    ok

    control @132 (request_type:i64,request:i64,value:i64,index:i64,length:i64)->bool =
      k = cells.state()
      u = cells.parent.usb.host()
      ok = false
      if u.ready and u.transfer_pending == 0 and length >= 0 and length <= 4096
        sys.memory_fill(sys.addr(k.data),0,4096)
        setup = request_type | (request << 8) | (value << 16) | (index << 32) | (length << 48)
        direction = (request_type & 128) != 0
        trt = length == 0 ? 0 : (direction ? 3 : 2)
        setup_trb = trb(false,setup,8,(2 << 10) | 64 | (trt << 16))
        if length > 0
          data_trb = trb(false,k.data,length,(3 << 10) | (direction ? 1 << 16 : 0))
        u.transfer_pending = trb(false,0,0,(4 << 10) | 32 | (length == 0 or not direction ? 1 << 16 : 0))
        u.transfer_slot = k.slot
        u.transfer_endpoint = 1
        u.transfer_code = 0
        u.transfer_remaining = 0
        sys.memory_fence()
        sys.store32(sys.addr(u.doorbells + k.slot * 4),1)
        polls = 0
        start = cells.parent.usb.ticks()
        while polls < 1000000 and u.transfer_pending > 0 and u.ready and ((cells.parent.usb.ticks() - start) & 16383) < 8000
          cells.parent.usb.command.events()
          polls += 1
          sys.pause()
        ok = u.transfer_pending == 0 and (u.transfer_code == 1 or u.transfer_code == 13)
      ok

      trb @131 (interrupt:bool,parameter:i64,status:i64,control:i64)->i64 =
        k = cells.state()
        ring = interrupt ? k.interrupt_ring : k.control_ring
        index = interrupt ? k.interrupt_index : k.control_index
        cycle = interrupt ? k.interrupt_cycle : k.control_cycle
        pointer = ring + index * 16
        sys.store64(sys.addr(pointer),parameter)
        sys.store32(sys.addr(pointer + 8),status)
        sys.release_fence()
        sys.store32(sys.addr(pointer + 12),control | cycle)
        index += 1
        if index == 63
          link = ring + 63 * 16
          sys.store64(sys.addr(link),ring)
          sys.store32(sys.addr(link + 8),0)
          sys.release_fence()
          sys.store32(sys.addr(link + 12),(6 << 10) | 2 | cycle)
          index = 0
          cycle = cycle ^ 1
        if interrupt
          k.interrupt_index = index
          k.interrupt_cycle = cycle
        else
          k.control_index = index
          k.control_cycle = cycle
        pointer

  queue @134 ()->unit =
    k = cells.state()
    u = cells.parent.usb.host()
    sys.memory_fill(sys.addr(k.report),0,8)
    u.transfer_pending = attach.control.trb(true,k.report,8,(1 << 10) | 32 | 4)
    u.transfer_slot = k.slot
    u.transfer_endpoint = k.endpoint
    u.transfer_code = 0
    u.transfer_remaining = 0
    sys.memory_fence()
    sys.store32(sys.addr(u.doorbells + k.slot * 4),k.endpoint)

  start @135 ()->bool =
    k = cells.state()
    if not k.attempted
      k.attempted = true
      available = cells.parent.usb.start()
      if available
        attempts = 0
        for port in 1..cells.parent.hardware.state().xhci_ports + 1
          if not k.ready and attempts < 8 and cells.parent.usb.host().ready
            status = sys.load32(sys.addr(cells.parent.usb.host().operational + 0x400 + (port - 1) * 16))
            if (status & 1) != 0
              attempts += 1
              k.ready = attach(port)
        if k.ready
          queue()
        else
          k.error = 2
      else
        k.error = 1
    k.ready

  // One USB command map drives both dispatch and the navigation repeat whitelist.
  repeat @139 ()->unit =
    k = cells.state()
    if k.ready and k.queued_count == 0 and k.repeat_usage > 0
      held = false
      for index in 2..8
        held = held or sys.load8(sys.addr(k.report + 8 + index)) == k.repeat_usage
      if not held or k.modifiers != k.repeat_modifiers or cells.parent.workspace.console().palette_open or not cells.parent.editor.document().editing
        k.repeat_usage = 0
      else if (cells.parent.usb.ticks() - k.repeat_tick + 16384) % 16384 >= k.repeat_wait
        k.usage = k.repeat_usage
        k.key_modifiers = k.repeat_modifiers
        k.repeat_tick = cells.parent.usb.ticks()
        k.repeat_wait = 400
        sys.scratch(press,32768)

  // Collect reports during painting without executing editor commands reentrantly.
  // The existing pinned 4 KiB report page also owns this bounded 32-report FIFO.
  collect @140 ()->unit =
    k = cells.state()
    u = cells.parent.usb.host()
    if k.ready
      if not u.ready
        k.ready = false
        k.error = 3
      else
        cells.parent.usb.command.events()
        if u.transfer_pending == 0 and k.queued_count < 32
          if (u.transfer_code == 1 or u.transfer_code == 13) and u.transfer_remaining == 0
            sys.memory_copy(sys.addr(k.report + 256 + k.queued_tail * 8),sys.addr(k.report),8)
            k.queued_tail = (k.queued_tail + 1) % 32
            k.queued_count += 1
            queue()
          else
            k.error = 4
            k.ready = false
            released = cells.parent.usb.command(10,k.slot,0)

  report @142 ()->unit =
    k = cells.state()
    cells.parent.workspace.write(Text("USB keyboard ready/error/port/VID:PID: "))
    cells.parent.workspace.number(k.ready ? 1 : 0)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(k.error)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(k.port)
    cells.parent.workspace.put(47)
    cells.parent.hardware.hex(k.vendor,4)
    cells.parent.workspace.put(58)
    cells.parent.hardware.hex(k.product,4)
    cells.parent.workspace.write(Text("\nASCII/US boot keyboard; direct root ports, no hubs or automatic reconnect.\nready> "))

  // Dedicated test state device. DMA is pinned in the physical pool; the snapshot stays in boot().
      keyboard @273 = keyboard():
        space keyboard @274:
          state @125 = keyboard.state()

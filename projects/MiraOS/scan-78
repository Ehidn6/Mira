    scan @78 ()->unit =
      h = cells.state()
      h.devices = 0
      h.xhci_count = 0
      h.nvme_count = 0
      h.network_count = 0
      h.xhci = -1
      h.nvme = -1
      h.virtio = -1
      for bus in 0..256
        for slot in 0..32
          base = (bus << 8) | (slot << 3)
          identity = pci_config(base,0)
          if (identity & 65535) != 65535 and (identity & 65535) != 0
            functions = (pci_config(base,12) & 0x800000) != 0 ? 8 : 1
            for function in 0..functions
              bdf = base + function
              identity = pci_config(bdf,0)
              if (identity & 65535) != 65535 and (identity & 65535) != 0
                h.devices += 1
                class = pci_config(bdf,8) >> 8
                if class == 0x0c0330
                  h.xhci_count += 1
                  if h.xhci < 0
                    h.xhci = bdf
                if class == 0x010802
                  h.nvme_count += 1
                  if h.nvme < 0
                    h.nvme = bdf
                if class >> 16 == 2
                  h.network_count += 1
                if identity == 0x10011af4 and h.virtio < 0
                  bar = pci_config(bdf,16)
                  port = bar & 65532
                  if (bar & 1) != 0 and port > 0 and port < 65504
                    features = sys.in32(port)
                    if (features & 512) != 0 and (features & 32) == 0 and sys.in32(port + 20) == cells.parent.storage.volume_sectors() and sys.in32(port + 24) == 0
                      h.virtio = bdf

      pci_config @76 (bdf:i64,reg:i64)->i64 =
        value = 0xffffffff
        if bdf >= 0 and bdf <= 65535 and reg >= 0 and reg <= 252 and reg % 4 == 0
          sys.out32(0xcf8,0x80000000 | (bdf << 8) | reg)
          value = sys.in32(0xcfc)
        value

      pci_bar0 @77 (bdf:i64)->i64 =
        base = 0
        if bdf >= 0 and (pci_config(bdf,12) & 0x7f0000) == 0
          low = pci_config(bdf,16)
          kind = (low >> 1) & 3
          if low != 0xffffffff and (low & 1) == 0 and (kind == 0 or kind == 2)
            base = low & 0xfffffff0
            if kind == 2
              high = pci_config(bdf,20)
              if high < 32768
                base = base | (high << 32)
              else
                base = 0
        base


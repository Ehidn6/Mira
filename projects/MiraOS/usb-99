usb @99 ()->unit =
  if cells.host().requested
    cells.host().requested = false
    if cells.host().ready
      accepted = command(23,0,0)
    else
      accepted = start()
    sys.scratch(report,2048)

// Direct-root HID boot keyboard. Device buffers are pinned physical pages.

  struct UsbHost @19 :
    requested: bool
    attempted: bool
    owned: bool
    ready: bool
    error: i64
    base: i64
    operational: i64
    doorbells: i64
    interrupter: i64
    dcbaa: i64
    command_ring: i64
    event_ring: i64
    event_table: i64
    command_index: i64
    command_cycle: i64
    event_index: i64
    event_cycle: i64
    pending: i64
    completion: i64
    last_slot: i64
    commands: i64
    events: i64
    port_events: i64
    connected: i64
    slots: i64
    context_bytes: i64
    transfer_pending: i64
    transfer_slot: i64
    transfer_endpoint: i64
    transfer_code: i64
    transfer_remaining: i64
  host @89 ()->UsbHost = UsbHost.persist()

  fail @93 (error:i64)->unit =
    start.stop()
    cells.host().error = error

  command @96 (kind:i64,slot:i64,parameter:i64)->bool =
    u = cells.host()
    ok = false
    valid = (kind == 23 or kind == 9) and slot == 0 and parameter == 0
    valid = valid or (kind == 10 and slot > 0 and slot <= u.slots and parameter == 0)
    if kind == 11 or kind == 12 or kind == 13
      h = cells.parent.hardware.state()
      valid = slot > 0 and slot <= u.slots and parameter >= h.pool_base and parameter <= h.pool_next - 4096 and parameter % 4096 == 0
    if u.ready and u.pending == 0 and valid
      pointer = u.command_ring + u.command_index * 16
      trb = sys.addr(pointer)
      sys.store64(trb,parameter)
      sys.store32(sys.offset(trb,8),0)
      sys.release_fence()
      sys.store32(sys.offset(trb,12),(slot << 24) | (kind << 10) | u.command_cycle)
      u.pending = pointer
      u.completion = 0
      u.command_index += 1
      if u.command_index == 63
        link = sys.offset(sys.addr(u.command_ring),63 * 16)
        sys.store64(link,u.command_ring)
        sys.store32(sys.offset(link,8),0)
        sys.release_fence()
        sys.store32(sys.offset(link,12),(6 << 10) | 2 | u.command_cycle)
        u.command_index = 0
        u.command_cycle = u.command_cycle ^ 1
      sys.memory_fence()
      sys.store32(sys.addr(u.doorbells),0)
      polls = 0
      while polls < 1000000 and u.pending > 0 and u.ready
        events()
        polls += 1
        sys.pause()
      ok = u.pending == 0 and u.completion == 1
      if ok
        u.commands += 1
      else
        fail(u.pending > 0 ? 8 : 9)
    ok

    events @95 ()->unit =
      u = cells.host()
      active = u.ready
      for index in 0..64
        if active
          event = sys.offset(sys.addr(u.event_ring),u.event_index * 16)
          control = sys.load32(sys.offset(event,12))
          if (control & 1) != u.event_cycle
            active = false
          else
            sys.acquire_fence()
            kind = (control >> 10) & 63
            if kind == 33
              pointer = sys.load64(event) & ~15
              if u.pending > 0 and pointer == u.pending
                u.completion = (sys.load32(sys.offset(event,8)) >> 24) & 255
                u.last_slot = (control >> 24) & 255
                u.pending = 0
            else if kind == 32
              pointer = sys.load64(event) & ~15
              slot = (control >> 24) & 255
              endpoint = (control >> 16) & 31
              if u.transfer_pending > 0 and pointer == u.transfer_pending and slot == u.transfer_slot and endpoint == u.transfer_endpoint
                status = sys.load32(sys.offset(event,8))
                u.transfer_code = (status >> 24) & 255
                u.transfer_remaining = status & 0xffffff
                u.transfer_pending = 0
            else if kind == 34
              u.port_events += 1
            u.events += 1
            u.event_index += 1
            if u.event_index == 64
              u.event_index = 0
              u.event_cycle = u.event_cycle ^ 1
            start.write64(u.interrupter + 24,(u.event_ring + u.event_index * 16) | 8)
            sys.store32(sys.addr(u.operational + 4),8)

  report @98 ()->unit =
    u = cells.host()
    cells.parent.workspace.write(Text("USB host ready/error/commands/events/connected: "))
    cells.parent.workspace.number(u.ready ? 1 : 0)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(u.error)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(u.commands)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(u.events)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(u.connected)
    cells.parent.workspace.write(Text("\n:K shows USB keyboard status.\nready> "))

  ticks @128 ()->i64 = sys.load32(sys.addr(cells.host().interrupter - 32)) & 16383
  delay @129 (ticks:i64)->bool =
    start = usb.ticks()
    polls = 0
    while polls < 1000000 and ((usb.ticks() - start) & 16383) < ticks
      polls += 1
      sys.pause()
    ((usb.ticks() - start) & 16383) >= ticks

      usb @271 = usb():
        space usb @272:
          host @124 = usb.host()

display @214 ()->unit =
  c = cells.parent.workspace.console()
  d = cells.parent.editor.document()
  if c.video and c.layout != 2
    caret_line = 0
    caret_column = 0
    if d.cursor > (d.scope_start + d.scope_end) / 2
      caret_line = d.scope_lines - 1
      for index in d.cursor..d.scope_end
        if cells.parent.editor.byte(index) == 10
          caret_line -= 1
      caret_column = d.cursor - cells.parent.editor.line_start(d.cursor)
    else
      for index in d.scope_start..d.cursor
        if cells.parent.editor.byte(index) == 10
          caret_line += 1
          caret_column = 0
        else
          caret_column += 1
    page_rows = c.editor_bottom - 3
    page_columns = c.source_right - c.source_left - 8
    if d.editing
      if caret_line < c.source_line
        c.source_line = caret_line
      if caret_line >= c.source_line + page_rows
        c.source_line = caret_line - page_rows + 1
      if caret_column < c.source_column
        c.source_column = caret_column
      if caret_column >= c.source_column + page_columns
        c.source_column = caret_column - page_columns + 1
    width = (c.source_right - c.source_left) * 32
    for row in 32..c.editor_bottom * 16
      sys.memory_fill(sys.offset(sys.addr(c.framebuffer),row * c.stride + c.source_left * 32),0,width)
    cyan = color(101,203,214)
    title = text(Text("SOURCE | object"),c.source_left + 1,2,cyan)
    if d.anchor_code > 0
      title = text(Text(" | anchor "),title,2,cyan)
      title = number(d.anchor_cell,title,2,cyan)
      text.glyph(47,title,2,cyan,0)
      title = number(d.anchor_code,title + 1,2,cyan)
    if d.dirty
      text.glyph(42,title + 1,2,color(245,196,99),0)
    window = LexBytes()
    lexer = LexState()
    index = d.scope_start
    line = 0
    if c.source_line > d.scope_lines / 2
      index = cells.parent.editor.line_start(d.scope_end)
      line = d.scope_lines - 1
      while line > c.source_line and index > d.scope_start
        index = cells.parent.editor.line_start(index - 1)
        line -= 1
    row = 3
    while index <= d.scope_end and row < c.editor_bottom
      end = cells.parent.editor.line_end(index)
      if end > d.scope_end
        end = d.scope_end
      if line >= c.source_line
        gutter = number(line + 1,c.source_left,row,color(82,115,133))
        draw_line(index,end,row,window,lexer)
        cells.parent.keyboard.collect()
        row += 1
      line += 1
      index = end + 1
    d.redraw = false



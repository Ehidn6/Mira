  init @208 ()->unit =
    c = cells.parent.workspace.console()
    info = sys.boot_info()
    if sys.load64(info) == 0x4f464e494152494d and sys.load64(sys.offset(info,8)) == 1 and sys.load64(sys.offset(info,16)) >= 256
      width = sys.load64(sys.offset(info,48))
      height = sys.load64(sys.offset(info,56))
      stride = sys.load64(sys.offset(info,64))
      size = sys.load64(sys.offset(info,40))
      format = sys.load64(sys.offset(info,72))
      valid = width >= 640 and width <= 8192 and height >= 400 and height <= 8192
      valid = valid and stride >= width * 4 and stride <= 65536 and stride * height <= size and stride * height <= 67108864
      valid = valid and (format == 0 or format == 1) and (sys.load64(sys.offset(info,24)) & 16) != 0
      if valid
        assets = sys.addr(sys.load64(sys.offset(info,248)))
        if sys.address_value(assets) != 0 and sys.load64(assets) == 0x313053414152494d and sys.load64(sys.offset(assets,8)) == 1 and sys.load64(sys.offset(assets,16)) >= 56

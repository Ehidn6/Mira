          if font > 0 and sys.load64(sys.offset(assets,48)) == 1024
            c.framebuffer = sys.load64(sys.offset(info,32))
            c.bytes = size
            c.width = width
            c.height = height
            c.stride = stride
            c.format = format
            c.font = font
            c.columns = width / 8
            c.rows = height / 16
            cells.parent.workspace.frame.config()
            c.video = c.framebuffer > 0
            c.frame_dirty = true
            c.dirty = true

  put @210 (code:i64)->unit =
    c = cells.parent.workspace.console()
    if c.video and (c.console_open or c.layout == 2 or c.output_region > 0)
      left = 1
      right = c.columns - 1
      top = c.console_top + 1
      bottom = c.rows - 1
      if c.output_region == 1
        right = c.nav_end - 1
        top = 3
        bottom = c.editor_bottom
      else if c.output_region == 2
        left = c.inspector_start + 1
        top = 3
        bottom = c.editor_bottom
      else if c.output_region == 3
        top = 0
        bottom = 1
      if code == 10
        c.x = left
        c.y += 1
      else if code == 13
        c.x = left
      else if code == 8
        if c.x > left
          c.x -= 1
      else if code >= 32
        if c.x >= right
          c.x = left
          c.y += 1
        if c.y >= bottom and c.output_region == 0
          scroll()
        if c.y >= top and c.y < bottom
          text.glyph(code,c.x,c.y,color(200,218,229),0)
        c.x += 1
      if c.y >= bottom and c.output_region == 0
        scroll()

    scroll @209 ()->unit =
      c = cells.parent.workspace.console()
      width = (c.columns - 2) * 32
      for row in (c.console_top + 1) * 16..(c.rows - 2) * 16
        target = sys.offset(sys.addr(c.framebuffer),row * c.stride + 32)
        sys.memory_copy(target,sys.offset(target,16 * c.stride),width)
      for row in (c.rows - 2) * 16..(c.rows - 1) * 16
        sys.memory_fill(sys.offset(sys.addr(c.framebuffer),row * c.stride + 32),0,width)
      c.y = c.rows - 2


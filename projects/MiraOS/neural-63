        index = node * 4 + lane
        stimulus = signal[lane] * (node == lane ? 0.7 : 0.05)
        potential = nodes[index] * 0.6 + incoming[index] + stimulus
        nodes[index] = activate(potential)
    // Bounded local Hebbian learning, independent of readout SGD.
    for edge in 0..16
      correlation = 0.0
      for lane in 0..4
        correlation += nodes[from[edge] * 4 + lane] * nodes[to[edge] * 4 + lane]
      value = weights[edge] + rate * 0.1 * (correlation * 0.25 - weights[edge] * 0.2)
      value = value < -0.5 ? -0.5 : value
      weights[edge] = value > 0.5 ? 0.5 : value


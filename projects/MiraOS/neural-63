cognition @63 ()->unit =
  s = cells.dynamics.state()
  if not s.paused and not s.quarantined
    s.pulse += 1
    // Cooperative pacing, not a hardware clock or a promised wall-time rate.
    if s.pulse >= 512
      s.pulse = 0
      s.attempts += 1
      s.fresh = false
      if s.event_count > 0
        observe_input()
      else if s.world_enabled
        predicted = sys.neural_try(discover,300000,8192)
        if not predicted
          s.quarantined = true
          cells.parent.workspace.write(Text("world prediction failed; neural component quarantined\n"))
      else if s.memory_count == 0 or s.attempts % 16 == 1
        observe_self()
      accepted = not s.quarantined and sys.neural_try(neural_step,300000,16384)
      if accepted
        s.streak = 0
        if s.steps % 128 == 0
          cells.parent.workspace.console().dirty = true
        d = cells.parent.storage.state()
        if d.bound and not d.foreign and (s.external > d.last_external or s.steps - d.last_steps >= 1024)
          d.requested = true
      else
        s.failures += 1
        s.streak += 1
        if s.streak >= 3
          s.quarantined = true
          cells.parent.workspace.write(Text("\nneural component quarantined; console remains available\nready> "))



source_analysis @200 ()->unit =
  d = cells.parent.editor.document()
  if d.check_requested
    d.check_requested = false
    sys.scratch(check,35000)
    sys.scratch(check_report,4096)


  runner()

  // Compile the selected editable definition using the existing Mira module API.
  type SourceDelimiters  @28 = [i64,256]
  selected_code @188 ()->unit =
    d = cells.parent.editor.document()
    node = cells.parent.workspace.console().graph_selected
    same = d.base0 == reflect.revision_word(0) and d.base1 == reflect.revision_word(1)
    same = same and d.base2 == reflect.revision_word(2) and d.base3 == reflect.revision_word(3)
    if same
      code = reflect.behavior(node)
      opened = cells.parent.editor.parts(code > 0 ? code : node)
      if opened
        d.anchor_cell = node
    else
      cells.parent.workspace.write(Text("Draft belongs to another build; use source open ID to browse its own identities.\n"))

  check @198 ()->unit =
    d = cells.parent.editor.document()
    window = LexBytes()
    state = LexState()
    brackets = SourceDelimiters()
    depth = 0
    line_start = 0
    d.check_status = 1
    d.check_revision = d.revision
    d.check_tokens = 0
    d.check_offset = 0
    while line_start < d.length and d.check_status == 1
      line_end = cells.parent.editor.line_end(line_start)
      position = line_start
      token_start = position
      base = position
      window_end = position
      refill = true
      state[0] = 0
      state[1] = 0
      while position < line_end and d.check_status == 1
        if state[0] == 0
          token_start = position
        if refill
          base = position
          window_end = base + 4096 < line_end ? base + 4096 : line_end
          for index in base..window_end
            window[index - base] = cells.parent.editor.byte(index)
          refill = false
        status = compiler(window,position - base,window_end - base,window_end == line_end,state)
        next = base + state[2]
        if status == 0
          if next <= base or next > window_end or window_end == line_end
            d.check_status = 6
            d.check_offset = position
          else
            position = next
            refill = true
        else if status < 0
          d.check_status = status == -1 ? 3 : (status == -2 ? 4 : (status == -3 ? 5 : 6))
          d.check_offset = token_start
        else if next <= token_start or next < position or next > window_end
          d.check_status = 6
          d.check_offset = position
        else
          if status <= 3
            d.check_tokens += 1
          if status == 3 and not quoted_name(token_start,next)
            d.check_status = 10
            d.check_offset = token_start
          if status == 1
            byte = cells.parent.editor.byte(token_start)
            if byte == 40 or byte == 91
              if depth < 128
                brackets[depth] = byte
                brackets[128 + depth] = token_start
                depth += 1
              else
                d.check_status = 9
                d.check_offset = token_start
            else if byte == 41 or byte == 93
              matches = false
              if depth > 0
                expected = byte == 41 ? 40 : 91
                matches = brackets[depth - 1] == expected
              if matches
                depth -= 1
              else
                d.check_status = 8
                d.check_offset = token_start
          position = next
      line_start = line_end + 1
    if d.check_status == 1
      if depth > 0
        d.check_status = 7
        d.check_offset = brackets[128 + depth - 1]
      else
        d.check_status = 2
        d.check_offset = d.length
    d.check_line = 1
    d.check_column = 1
    for index in 0..d.check_offset
      if cells.parent.editor.byte(index) == 10
        d.check_line += 1
        d.check_column = 1
      else
        d.check_column += 1
    d.redraw = true
    cells.parent.workspace.console().dirty = true

    quoted_name @197 (start:i64,end:i64)->bool =
      first = true
      valid = end > start + 2
      for index in start + 1..end - 1
        byte = cells.parent.editor.byte(index)
        if byte == 45
          valid = valid and not first
          first = true
        else
          valid = valid and (compiler.letter(byte) or byte == 95 or (not first and compiler.digit(byte)))
          first = false
      valid = valid and not first
      if end - start == 4
        valid = valid and not (cells.parent.editor.byte(start + 1) == 97 and cells.parent.editor.byte(start + 2) == 116)
      if end - start == 7
        valid = valid and not (cells.parent.editor.byte(start + 1) == 115 and cells.parent.editor.byte(start + 2) == 112 and cells.parent.editor.byte(start + 3) == 97 and cells.parent.editor.byte(start + 4) == 99 and cells.parent.editor.byte(start + 5) == 101)
      valid

  check_report @199 ()->unit =
    d = cells.parent.editor.document()
    cells.parent.workspace.write(Text("source check revision/status/line/column/tokens: "))
    cells.parent.workspace.number(d.check_revision)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(d.check_status)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(d.check_line)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(d.check_column)
    cells.parent.workspace.put(47)
    cells.parent.workspace.number(d.check_tokens)
    cells.parent.workspace.put(10)
    if d.check_revision != d.revision
      cells.parent.workspace.write(Text("Check is stale: the document has changed.\n"))
    else if d.check_status == 2
      cells.parent.workspace.write(Text("Lexical scan and delimiters passed; grammar/types are NOT checked. Code unchanged.\n"))
    else
      if d.check_status == 3
        cells.parent.workspace.write(Text("Unsupported character.\n"))
      else if d.check_status == 4
        cells.parent.workspace.write(Text("Unclosed text literal.\n"))
      else if d.check_status == 5
        cells.parent.workspace.write(Text("Unclosed quoted identifier.\n"))
      else if d.check_status == 7
        cells.parent.workspace.write(Text("Unclosed bracket.\n"))
      else if d.check_status == 8
        cells.parent.workspace.write(Text("Unexpected or mismatched closing bracket.\n"))
      else if d.check_status == 9
        cells.parent.workspace.write(Text("Check nesting limit reached (128 brackets).\n"))
      else if d.check_status == 10
        cells.parent.workspace.write(Text("Invalid quoted identifier.\n"))
      else
        cells.parent.workspace.write(Text("Scanner contract failure; source retained.\n"))
      cells.parent.workspace.write(Text(":f opens the source at this error.\n"))
    if not d.editing
      cells.parent.workspace.write(Text("ready> "))

  error_focus @201 ()->unit =
    d = cells.parent.editor.document()
    if d.check_status >= 3 and d.check_revision == d.revision
      if d.check_offset < d.scope_start or d.check_offset > d.scope_end
        opened = cells.parent.editor.parts(reflect.root())
      d.cursor = d.check_offset
      cells.parent.editor.open()
    else
      cells.parent.workspace.write(Text("No current source error; :v checks the current draft.\n"))

  // Workspace regions are views of this loaded program, not separate applications.
      source_analysis @286 = source_analysis()

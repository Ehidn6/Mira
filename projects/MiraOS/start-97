  start @97 ()->bool =
    u = cells.host()
    h = cells.parent.hardware.state()
    if not u.attempted
      u.attempted = true
      cells.parent.hardware.probe()
      if h.xhci_bar == 0
        u.error = 1
      else
        u.base = h.xhci_bar
        u.operational = u.base + (sys.load32(sys.addr(u.base)) & 255)
        db = sys.load32(sys.addr(u.base + 20)) & ~3
        runtime = sys.load32(sys.addr(u.base + 24)) & ~31
        caps = sys.load32(sys.addr(u.base + 16))
        params = sys.load32(sys.addr(u.base + 8))
        scratchpads = ((params >> 27) & 31) | (((params >> 21) & 31) << 5)
        u.slots = h.xhci_slots < 8 ? h.xhci_slots : 8
        u.context_bytes = (caps & 4) != 0 ? 64 : 32
        ok = db >= 256 and db <= 1044480 and runtime >= 256 and runtime <= 1044480 and scratchpads <= 64
        if ok
          ok = cells.parent.hardware.mmio_map(u.operational,0x400 + h.xhci_ports * 16) and cells.parent.hardware.mmio_map(u.base + db,64) and cells.parent.hardware.mmio_map(u.base + runtime,64)
        if not ok
          u.error = 2
        else if not handoff()
          u.error = 3
        else
          u.owned = true
          u.doorbells = u.base + db
          u.interrupter = u.base + runtime + 32
          ok = wait(u.operational + 4,0x800,0,1000000)
          if ok
            command = sys.load32(sys.addr(u.operational))
            sys.store32(sys.addr(u.operational),command & ~5)
            ok = wait(u.operational + 4,1,1,1000000)
          if ok
            sys.store32(sys.addr(u.operational),2)
            ok = wait(u.operational,2,0,1000000) and wait(u.operational + 4,0x800,0,1000000)
          if not ok
            fail(4)
          else if (sys.load32(sys.addr(u.operational + 8)) & 1) == 0
            fail(5)
          else
            u.dcbaa = cells.parent.hardware.physical_allocate(1,4096)
            u.command_ring = cells.parent.hardware.physical_allocate(1,4096)
            u.event_ring = cells.parent.hardware.physical_allocate(1,4096)
            u.event_table = cells.parent.hardware.physical_allocate(1,4096)
            ok = u.dcbaa > 0 and u.command_ring > 0 and u.event_ring > 0 and u.event_table > 0
            if ok and scratchpads > 0
              array = cells.parent.hardware.physical_allocate(1,4096)
              pages = cells.parent.hardware.physical_allocate(scratchpads,4096)
              ok = array > 0 and pages > 0
              if ok
                for index in 0..scratchpads
                  sys.store64(sys.offset(sys.addr(array),index * 8),pages + index * 4096)
                sys.store64(sys.addr(u.dcbaa),array)
            if not ok
              fail(6)
            else
              u.command_cycle = 1
              u.event_cycle = 1
              sys.store64(sys.addr(u.event_table),u.event_ring)
              sys.store32(sys.addr(u.event_table + 8),64)
              sys.memory_fence()
              write64(u.operational + 48,u.dcbaa)
              write64(u.operational + 24,u.command_ring | 1)
              sys.store32(sys.addr(u.operational + 56),u.slots)
              sys.store32(sys.addr(u.interrupter),0)
              sys.store32(sys.addr(u.interrupter + 4),0)
              sys.store32(sys.addr(u.interrupter + 8),1)
              write64(u.interrupter + 24,u.event_ring)
              write64(u.interrupter + 16,u.event_table)
              bdf = h.xhci
              command = cells.parent.hardware.init.scan.pci_config(bdf,4) & 65535
              sys.out32(0xcf8,0x80000004 | (bdf << 8))
              sys.out16(0xcfc,command | 0x406)
              sys.memory_fence()
              sys.store32(sys.addr(u.operational),1)
              if wait(u.operational + 4,1,0,1000000)
                u.ready = true
                accepted = usb.command(23,0,0)
                if accepted
                  for index in 0..h.xhci_ports
                    port = sys.load32(sys.addr(u.operational + 0x400 + index * 16))
                    if (port & 1) != 0
                      u.connected += 1
              else
                fail(7)
    u.ready

    write64 @90 (address:i64,value:i64)->unit =
      // xHCI supports ordered low/high DWORD writes to its 64-bit registers.
      sys.store32(sys.addr(address),value & 0xffffffff)
      sys.store32(sys.offset(sys.addr(address),4),(value >> 32) & 0xffffffff)

    wait @91 (address:i64,mask:i64,expected:i64,limit:i64)->bool =
      count = 0
      while count < limit and (sys.load32(sys.addr(address)) & mask) != expected
        count += 1
        sys.pause()
      (sys.load32(sys.addr(address)) & mask) == expected

    stop @92 ()->unit =
      u = cells.host()
      if u.owned and u.operational > 0
        command = sys.load32(sys.addr(u.operational))
        sys.store32(sys.addr(u.operational),command & ~5)
        stopped = wait(u.operational + 4,1,1,1000000)
        bdf = cells.parent.hardware.state().xhci
        if bdf >= 0
          command = cells.parent.hardware.init.scan.pci_config(bdf,4) & 65535
          sys.out32(0xcf8,0x80000004 | (bdf << 8))
          sys.out16(0xcfc,command & ~4)
      u.ready = false

    handoff @94 ()->bool =
      u = cells.host()
      offset = ((sys.load32(sys.offset(sys.addr(u.base),16)) >> 16) & 65535) * 4
      ok = true
      for index in 0..64
        if offset > 0 and ok
          if offset < 32 or offset > 1048568 or not cells.parent.hardware.mmio_map(u.base + offset,8)
            ok = false
          else
            address = u.base + offset
            capability = sys.load32(sys.addr(address))
            if capability == 0xffffffff or capability == 0
              ok = false
            else
              if (capability & 255) == 1
                // Request ownership through only the OS byte; never force-clear BIOS ownership.
                sys.store8(sys.offset(sys.addr(address),3),((capability >> 24) & 255) | 1)
                ok = wait(address,0x01010000,0x01000000,10000000)
                if ok
                  control = sys.load32(sys.offset(sys.addr(address),4))
                  sys.store32(sys.offset(sys.addr(address),4),control & 0x1fee)
              offset += ((capability >> 8) & 255) * 4
              if ((capability >> 8) & 255) == 0
                offset = 0
      ok and offset == 0


  command @181 (action:i64)->unit =
    d = cells.document()
    count = d.argument_active ? d.argument : 1
    d.argument_active = false
    d.argument_digits = false
    d.argument = 0
    if count > 1000
      count = 1000
    for repetition in 0..count
      if action == 1 or action == 2
        home(action == 2)
      else if action == 3 or action == 4
        horizontal(action == 3 ? 1 : -1)
      else if action == 5 or action == 6
        vertical(action == 5 ? 1 : -1)
      else if action == 7 or action == 8
        d.cursor = word_edge(action == 7 ? 1 : -1)
        d.preferred_column = -1
      else if action == 9
        end = line_end(d.cursor)
        if end > d.scope_end
          end = d.scope_end
        if end == d.cursor and end < d.scope_end
          end += 1
        for byte in d.cursor..end
          erase(false)
      else if action == 10 or action == 11
        edge = word_edge(action == 10 ? -1 : 1)
        amount = action == 10 ? d.cursor - edge : edge - d.cursor
        for byte in 0..amount
          erase(action == 10)
      else if action == 12 or action == 13
        page(action == 12 ? -1 : 1)
      else if action == 14 or action == 15
        erase(action == 15)
      else if action == 16 or action == 17
        d.cursor = action == 16 ? d.scope_start : d.scope_end
        d.preferred_column = -1
    d.redraw = true
    cells.parent.workspace.console().dirty = true

    word_byte @179 (value:i64)->bool =
      (value >= 48 and value <= 57) or (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 95

    word_edge @180 (direction:i64)->i64 =
      d = cells.document()
      position = d.cursor
      if direction > 0
        while position < d.scope_end and not word_byte(byte(position))
          position += 1
        while position < d.scope_end and word_byte(byte(position))
          position += 1
      else
        while position > d.scope_start and not word_byte(byte(position - 1))
          position -= 1
        while position > d.scope_start and word_byte(byte(position - 1))
          position -= 1
      position

    horizontal @182 (direction:i64)->unit =
      d = cells.document()
      next = d.cursor + direction
      if next >= d.scope_start and next <= d.scope_end
        d.cursor = next
      d.preferred_column = -1
      d.redraw = true

    home @183 (end:bool)->unit =
      d = cells.document()
      d.cursor = end ? line_end(d.cursor) : line_start(d.cursor)
      if d.cursor < d.scope_start
        d.cursor = d.scope_start
      if d.cursor > d.scope_end
        d.cursor = d.scope_end
      d.preferred_column = -1
      d.redraw = true

    vertical @184 (direction:i64)->unit =
      d = cells.document()
      start = line_start(d.cursor)
      if d.preferred_column < 0
        d.preferred_column = d.cursor - start
      if direction < 0 and start > d.scope_start
        previous = line_start(start - 1)
        length = start - previous - 1
        d.cursor = previous + (d.preferred_column < length ? d.preferred_column : length)
      else if direction > 0
        end = line_end(d.cursor)
        if end < d.scope_end
          next = end + 1
          length = line_end(next) - next
          d.cursor = next + (d.preferred_column < length ? d.preferred_column : length)
      if d.cursor < d.scope_start
        d.cursor = d.scope_start
      if d.cursor > d.scope_end
        d.cursor = d.scope_end
      d.redraw = true

    page @185 (direction:i64)->unit =
      count = cells.parent.workspace.console().video ? cells.parent.workspace.console().editor_bottom - 3 : 24
      for index in 0..count
        vertical(direction)

    down @215 ()->unit =
      c = cells.parent.workspace.console()
      if c.video and c.layout != 2 and c.source_line + c.editor_bottom - 3 < cells.document().scope_lines
        c.source_line += c.editor_bottom - 3
        cells.document().redraw = true

    up @216 ()->unit =
      c = cells.parent.workspace.console()
      if c.layout != 2
        c.source_line = c.source_line >= c.editor_bottom - 3 ? c.source_line - (c.editor_bottom - 3) : 0
        cells.document().redraw = true

